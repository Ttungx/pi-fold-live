{
  "name": "pi-fold-live",
  "version": "1.0.0",
  "type": "module",
  "description": "Pi Fold Live: readable Pi transcripts with collapsible work, a live action that stays open, and native final replies",
  "license": "MIT",
  "author": "Ttungx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ttungx/pi-fold-live.git"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:work": "node scripts/preview-work-strip.mjs",
    "benchmark": "node --expose-gc scripts/performance-review.mjs",
    "benchmark:memory": "node --expose-gc scripts/retained-memory-review.mjs",
    "test:compatibility": "node scripts/compatibility-check.mjs --pi latest"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "terminal",
    "tui",
    "pi-fold",
    "pi-fold-live",
    "transcript",
    "follow"
  ],
  "homepage": "https://github.com/Ttungx/pi-fold-live#readme",
  "bugs": {
    "url": "https://github.com/Ttungx/pi-fold-live/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "jiti": "^2.7.0",
    "pi-prompt-jump": "^0.1.0",
    "pi-subagents": "^0.83.1"
  }
}
